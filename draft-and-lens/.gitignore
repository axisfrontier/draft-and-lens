# Dependencies
node_modules/
.pnp
.pnp.js

# Build
.next/
out/
build/
dist/

# Environment — never commit secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Testing
coverage/

# Vercel
.vercel

# TypeScript
*.tsbuildinfo

# Optional — regenerate from DraftAndLens.html via scripts/extract-prompts.mjs
scripts/.extracted/

# clerk configuration (can include secrets)
/.clerk/

# Vercel deploy hook URL (local only, never commit)
.deploy-hook
.vercel-deploy-hook

# Local editor/tool launch config — machine-specific, not shared setup.
.claude/launch.json

# Throwaway verification probes. The convention is a leading .tmp- so they
# are recognisable as scratch; they call the real brains against the real
# database and are written for one session, not for reuse.
scripts/.tmp-*
